{
  "name": "viteplus-fastify",
  "version": "1.0.0",
  "description": "Modern VitePlus Fastify template with TypeScript and latest conventions",
  "keywords": [
    "fastify",
    "modern",
    "nodejs",
    "rest-api",
    "starter",
    "typescript"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development APP_ENV=development vp pack --watch --on-success \"vp run start:dev\"",
    "start:dev": "cross-env NODE_ENV=development APP_ENV=development node ./dist/server.mjs",
    "start": "cross-env NODE_ENV=production node ./dist/server.mjs",
    "start:prod": "cross-env NODE_ENV=production node ./dist/server.mjs",
    "build": "cross-env NODE_ENV=production vp run build:server && vp run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "vp pack",
    "build:dev": "vp pack",
    "compile-schemas": "json2ts -i src/schemas -o src/types",
    "check": "vp check",
    "type-check": "tsc --noEmit",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fastify/autoload": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/vite": "^9.1.1",
    "dayjs": "^1.11.21",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "mysql": "^2.18.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plus": "0.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
